  "x-idempotency": {
    "hash": "SHA-256 of exact persisted UTF-8 request body bytes",
    "scope": [
      "principal",
      "method",
      "route",
      "Idempotency-Key"
    ],
    "mismatch_status": 409
  },
  "x-error-statuses": {
    "400": "invalid_request",
    "401": "unauthorized",
    "403": "forbidden",
    "404": "not_found",
    "409": "idempotency_conflict or stale_lease",
    "413": "invalid_request (oversized body)",
    "422": "unsupported_version or invalid_request",
    "429": "capacity_hold with Retry-After",
    "503": "temporarily_unavailable with Retry-After"
  },
  "x-consumer-enrollment": "Each claiming principal has a configured inbox UUID per direction. Changed inbox requires explicit operator re-enrollment and reconciliation; a consumer with missing DB must not reuse an identity.",
  "x-restore": "Broker generation persists across ordinary restarts; isolated stale restore requires explicit generation rotation with draining disabled and destination/quota reconciliation.",
  "x-digest-recipes": {
    "factory-visible-text-v1": "visible_text_sha256; UTF-8 of factory net.PageParser.result text, SHA-256",
    "raw-http-body-v1": "raw_body_sha256; exact bounded decoded HTTP entity bytes, SHA-256"
  },
  "x-causal-projection": "Store immutable events; project only contiguous revisions within evaluation_id, matching previous_event_id. Late earlier revisions cannot regress a verified outcome. New evaluation IDs are distinct histories.",
  "x-authorization": "Credential grants exact application/client pairs and route capabilities. Claims require a single explicit scope. Browser Origin is refused; tokens are independent of human browser authentication."
}
