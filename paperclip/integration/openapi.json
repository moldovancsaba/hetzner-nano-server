{
  "openapi": "3.1.0",
  "info": {
    "title": "Paperclip\u2013OpenClaw Source Exchange",
    "version": "1.0.0-rc2",
    "description": "Versioned source exchange implementation contract. Loopback service behind scoped machine HTTPS; no search, inference, customer-send or destination write capability."
  },
  "servers": [
    {
      "url": "https://paperclip.haho.ai/integrations/v1",
      "description": "Proposed HTTPS origin; not enabled by this contract."
    }
  ],
  "paths": {
    "/source-offers": {
      "post": {
        "operationId": "storeSourceOffer",
        "security": [
          {
            "ScopedBearer": []
          }
        ],
        "x-required-scope": "sources:write",
        "responses": {
          "202": {
            "description": "Committed result after durable persistence. Replays return the stored original response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StoredReceipt"
                }
              }
            }
          },
          "default": {
            "description": "Bounded error; retry only when retryable, with original request identity.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SourceOffer"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "Persisted UUID, unique to the authenticated principal. The first commit binds it to method, exact route and original UTF-8 body SHA-256. Any changed route or body conflicts. Replays return the saved original response, even if its lease expired.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/deliveries/claim": {
      "post": {
        "operationId": "claimSources",
        "security": [
          {
            "ScopedBearer": []
          }
        ],
        "x-required-scope": "sources:claim",
        "responses": {
          "200": {
            "description": "Committed result after durable persistence. Replays return the stored original response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClaimSourcesResponse"
                }
              }
            }
          },
          "default": {
            "description": "Bounded error; retry only when retryable, with original request identity.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClaimRequest"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "Persisted UUID, unique to the authenticated principal. The first commit binds it to method, exact route and original UTF-8 body SHA-256. Any changed route or body conflicts. Replays return the saved original response, even if its lease expired.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/deliveries/{delivery_id}/receipt": {
      "post": {
        "operationId": "acknowledgeSource",
        "security": [
          {
            "ScopedBearer": []
          }
        ],
        "x-required-scope": "sources:claim",
        "responses": {
          "200": {
            "description": "Committed result after durable persistence. Replays return the stored original response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AcknowledgedReceipt"
                }
              }
            }
          },
          "default": {
            "description": "Bounded error; retry only when retryable, with original request identity.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IntakeReceipt"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "Persisted UUID, unique to the authenticated principal. The first commit binds it to method, exact route and original UTF-8 body SHA-256. Any changed route or body conflicts. Replays return the saved original response, even if its lease expired.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "delivery_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/events": {
      "post": {
        "operationId": "storeOutcomeEvent",
        "security": [
          {
            "ScopedBearer": []
          }
        ],
        "x-required-scope": "events:write",
        "responses": {
          "202": {
            "description": "Committed result after durable persistence. Replays return the stored original response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StoredReceipt"
                }
              }
            }
          },
          "default": {
            "description": "Bounded error; retry only when retryable, with original request identity.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OutcomeEvent"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "Persisted UUID, unique to the authenticated principal. The first commit binds it to method, exact route and original UTF-8 body SHA-256. Any changed route or body conflicts. Replays return the saved original response, even if its lease expired.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/events/claim": {
      "post": {
        "operationId": "claimEvents",
        "security": [
          {
            "ScopedBearer": []
          }
        ],
        "x-required-scope": "events:claim",
        "responses": {
          "200": {
            "description": "Committed result after durable persistence. Replays return the stored original response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClaimEventsResponse"
                }
              }
            }
          },
          "default": {
            "description": "Bounded error; retry only when retryable, with original request identity.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClaimRequest"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "Persisted UUID, unique to the authenticated principal. The first commit binds it to method, exact route and original UTF-8 body SHA-256. Any changed route or body conflicts. Replays return the saved original response, even if its lease expired.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/events/{delivery_id}/receipt": {
      "post": {
        "operationId": "acknowledgeEvent",
        "security": [
          {
            "ScopedBearer": []
          }
        ],
        "x-required-scope": "events:claim",
        "responses": {
          "200": {
            "description": "Committed result after durable persistence. Replays return the stored original response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AcknowledgedReceipt"
                }
              }
            }
          },
          "default": {
            "description": "Bounded error; retry only when retryable, with original request identity.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IntakeReceipt"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "Persisted UUID, unique to the authenticated principal. The first commit binds it to method, exact route and original UTF-8 body SHA-256. Any changed route or body conflicts. Replays return the saved original response, even if its lease expired.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "delivery_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/operations/{operation_id}": {
      "get": {
        "operationId": "getOwnOperation",
        "security": [
          {
            "ScopedBearer": []
          }
        ],
        "x-required-scope": "operations:read",
        "responses": {
          "200": {
            "description": "Committed result after durable persistence. Replays return the stored original response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationStatus"
                }
              }
            }
          },
          "default": {
            "description": "Bounded error; retry only when retryable, with original request identity.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "operation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "description": "Return only this principal\u2019s immutable operation result including exact route, request digest, original HTTP status and response. Never rerun an expired claim on lookup."
      }
    },
    "/status": {
      "get": {
        "operationId": "getTransportStatus",
        "security": [
          {
            "ScopedBearer": []
          }
        ],
        "x-required-scope": "status:read",
        "responses": {
          "200": {
            "description": "Committed result after durable persistence. Replays return the stored original response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceStatus"
                }
              }
            }
          },
          "default": {
            "description": "Bounded error; retry only when retryable, with original request identity.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Read-only metadata filtered to the caller scope; credentials, source bodies and contact text are excluded."
      }
    },
    "/snapshot": {
      "get": {
        "operationId": "readAggregateSnapshot",
        "security": [
          {
            "ScopedBearer": []
          }
        ],
        "x-required-scope": "status:read",
        "description": "Bounded scoped aggregate with explicit per-producer coverage. Never raw source/contact bodies. Missing qualification, source effort or spend instrumentation is null, not zero. Counts cover observations received during the last 24 hours; delivery history is bounded to twenty observations per client. Causally incomplete feedback is visible but is not counted as an accepted or confirmed effect.",
        "responses": {
          "200": {
            "description": "Aggregate snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AggregateSnapshot"
                }
              }
            }
          },
          "default": {
            "description": "Scoped typed error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ScopedBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Independent revocable machine identity; scopes and application/client allowlists enforced server-side. Browser password and session cookies do not authorize this API."
      }
    },
    "schemas": {
      "Scope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "application": {
            "type": "string",
            "enum": [
              "classscout",
              "management",
              "salesleadgenerator"
            ]
          },
          "client": {
            "type": "string",
            "minLength": 1,
            "maxLength": 48,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,47}$"
          }
        },
        "required": [
          "application",
          "client"
        ],
        "description": "Application/client pairs are allowlisted by authenticated identity and the existing destination registry. Enum membership alone grants no access."
      },
      "PublicClaim": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "field": {
            "type": "string",
            "enum": [
              "name",
              "address",
              "ages",
              "price",
              "schedule",
              "activity",
              "program_url"
            ]
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "source_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "maxLength": 2048
          },
          "page_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "field",
          "value",
          "quote",
          "source_url",
          "page_sha256"
        ]
      },
      "SourceOffer": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": "1.1"
          },
          "packet_id": {
            "type": "string",
            "format": "uuid"
          },
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "source_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "maxLength": 2048
          },
          "source_kind": {
            "type": "string",
            "enum": [
              "official_branch",
              "official_program",
              "official_contact",
              "directory_lead"
            ]
          },
          "fetched_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "page_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "provider_name_hint": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "branch_hint": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "gap_fields": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "identity",
                "address",
                "children",
                "ages",
                "price",
                "schedule",
                "program_dates",
                "contact",
                "activity"
              ]
            },
            "maxItems": 9
          },
          "policy_review_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "producer_task_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "claims": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicClaim"
            },
            "maxItems": 10
          },
          "extraction_recipe_id": {
            "type": "string",
            "enum": [
              "factory-visible-text-v1",
              "raw-http-body-v1"
            ]
          },
          "digest_kind": {
            "type": "string",
            "enum": [
              "visible_text_sha256",
              "raw_body_sha256"
            ]
          }
        },
        "required": [
          "schema_version",
          "packet_id",
          "scope",
          "source_url",
          "source_kind",
          "fetched_at",
          "expires_at",
          "page_sha256",
          "policy_review_ref",
          "producer_task_ref",
          "gap_fields",
          "claims",
          "extraction_recipe_id",
          "digest_kind"
        ],
        "description": "Immutable public-source lead, never publication authority. Runtime checks enforce public-IP HTTPS, source permissions, expiry, same-source claim hashes/quotes, and branch identity. Directory leads cannot carry official claims."
      },
      "StoredReceipt": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid"
          },
          "resource_id": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string",
            "enum": [
              "broker_saved"
            ]
          },
          "received_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "operation_id",
          "resource_id",
          "state",
          "received_at"
        ]
      },
      "ClaimRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "lease_seconds": {
            "type": "integer",
            "minimum": 120,
            "maximum": 300
          },
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "inbox_id": {
            "type": "string",
            "format": "uuid"
          },
          "broker_generation": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "limit",
          "lease_seconds",
          "scope",
          "inbox_id",
          "broker_generation"
        ]
      },
      "SourceDelivery": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "delivery_id": {
            "type": "string",
            "format": "uuid"
          },
          "lease_token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "lease_expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "offer": {
            "$ref": "#/components/schemas/SourceOffer"
          },
          "broker_generation": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "delivery_id",
          "lease_token",
          "lease_expires_at",
          "offer",
          "broker_generation"
        ]
      },
      "ClaimSourcesResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SourceDelivery"
            },
            "maxItems": 10
          },
          "retry_after_seconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3600
          }
        },
        "required": [
          "items",
          "retry_after_seconds"
        ]
      },
      "IntakeReceipt": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "lease_token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "local_receipt_id": {
            "type": "string",
            "format": "uuid"
          },
          "disposition": {
            "type": "string",
            "enum": [
              "received",
              "duplicate",
              "policy_refused",
              "expired"
            ]
          },
          "reason_code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-z0-9_-]+$"
          },
          "local_reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "inbox_id": {
            "type": "string",
            "format": "uuid"
          },
          "broker_generation": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "lease_token",
          "local_receipt_id",
          "disposition",
          "reason_code",
          "local_reference",
          "scope",
          "inbox_id",
          "broker_generation"
        ],
        "description": "received acknowledges a durably stored local inbox item, not successful validation or publication. Expired leases fail unless the exact previously committed operation is being replayed."
      },
      "AcknowledgedReceipt": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid"
          },
          "delivery_id": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string",
            "enum": [
              "acknowledged"
            ]
          },
          "acknowledged_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "operation_id",
          "delivery_id",
          "state",
          "acknowledged_at"
        ]
      },
      "Readback": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "destination_type": {
            "type": "string",
            "enum": [
              "provider",
              "lead",
              "ingest_card",
              "listing"
            ]
          },
          "destination_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "checked_at": {
            "type": "string",
            "format": "date-time"
          },
          "result": {
            "type": "string",
            "enum": [
              "found_matching",
              "found_conflict",
              "missing",
              "unavailable"
            ]
          },
          "publication": {
            "type": "string",
            "enum": [
              "public",
              "not_public",
              "unknown"
            ]
          },
          "verification_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "checked_fields": {
            "type": "array",
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 100
            }
          },
          "content_revision": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 160
          }
        },
        "required": [
          "destination_type",
          "destination_id",
          "checked_at",
          "result",
          "publication",
          "verification_ref",
          "checked_fields",
          "content_revision"
        ],
        "description": "public is valid only for found_matching with an independently checked authoritative publication predicate. Missing or unavailable readback is never evidence of publication.",
        "allOf": [
          {
            "if": {
              "properties": {
                "result": {
                  "const": "found_matching"
                }
              },
              "required": [
                "result"
              ]
            },
            "then": {
              "properties": {
                "checked_fields": {
                  "minItems": 1
                },
                "content_revision": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      },
      "GapPayload": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "event_type": {
            "const": "gap_report"
          },
          "candidate_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "gap_fields": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "identity",
                "address",
                "children",
                "ages",
                "price",
                "schedule",
