<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>ai.narimato.paperclip-backup</string>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Library/Developer/CommandLineTools/usr/bin/python3</string>
		<string>/Users/Shared/Projects/hetzner/paperclip/backup.py</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/Shared/Projects/hetzner/private/paperclip/daily-backups/scheduled-error.log</string>
	<key>StandardOutPath</key>
	<string>/Users/Shared/Projects/hetzner/private/paperclip/daily-backups/scheduled.log</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>3</integer>
		<key>Minute</key>
		<integer>20</integer>
	</dict>
	<key>StartInterval</key>
	<integer>3600</integer>
	<key>WorkingDirectory</key>
	<string>/Users/Shared/Projects/hetzner</string>
</dict>
</plist>
