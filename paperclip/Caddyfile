paperclip.haho.ai {
	@jev_workflow path /jev/v1/*
	handle @jev_workflow {
		uri strip_prefix /jev
		reverse_proxy 127.0.0.1:8781
	}

	@source_exchange path /integrations/v1/source-offers /integrations/v1/deliveries/claim /integrations/v1/deliveries/*/receipt /integrations/v1/events /integrations/v1/events/claim /integrations/v1/events/*/receipt /integrations/v1/operations/* /integrations/v1/status /integrations/v1/snapshot
	handle @source_exchange {
		reverse_proxy 127.0.0.1:9091
	}

	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		Strict-Transport-Security "max-age=31536000"
		X-Robots-Tag "noindex, nofollow"
	}
	handle /_access/* {
		reverse_proxy 127.0.0.1:8088 {
			header_up X-Real-IP {remote_host}
		}
	}
	handle {
		route {
			forward_auth 127.0.0.1:8088 {
				uri /_access/check
			}
			redir /jev /jev/ 308
			@jev_hitl path /jev/*
			handle @jev_hitl {
				reverse_proxy 127.0.0.1:8780 {
					header_up X-Jev-Ingress <redacted>
				}
			}
			@exchange_snapshot path /factory/exchange-snapshot
			handle @exchange_snapshot {
				rewrite * /integrations/v1/snapshot
				import /etc/caddy/source-exchange-dashboard.caddy
			}
			handle_path /factory/exchange/* {
				root * /opt/source-exchange/dashboard
				header Cache-Control no-store
				header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'none'; connect-src 'self'"
				file_server
			}
			@company_shell path /factory /factory/
			handle @company_shell {
				root * /opt/source-exchange/dashboard
				rewrite * /index.html
				header Cache-Control no-store
				header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'none'; connect-src 'self'"
				file_server
			}
			@company_results path /factory/metrics
			handle @company_results {
				reverse_proxy 127.0.0.1:9089
			}
			handle {
				reverse_proxy 127.0.0.1:3100
			}
		}
	}
}
