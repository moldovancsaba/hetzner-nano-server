chatbotapi.haho.ai {
    @gateway path /v1/models /v1/chat/completions /v1/jobs /v1/jobs/* /v1/job-types /v1/queue /v1/moderation/*
    handle @gateway {
        request_body {
            max_size 6MB
        }
        reverse_proxy 127.0.0.1:8090
    }
    @chat path /chat /chat/*
    handle @chat {
        request_body {
            max_size 128KB
        }
        reverse_proxy 127.0.0.1:8088
    }
    handle {
        respond "Unauthorized" 401
    }
}
