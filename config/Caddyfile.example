chatbotapi.haho.ai {
    # Public aggregate results only; private API routes below remain authenticated.
    redir /benchmarks /benchmarks/ 308
    handle_path /benchmarks/* {
        root * /var/www/narimato-benchmarks
        header Cache-Control "public, max-age=300"
        header X-Content-Type-Options "nosniff"
        file_server
    }

    @gateway path /v1/usage /v1/models /v1/chat/completions /v1/jobs /v1/jobs/* /v1/job-types /v1/queue /v1/moderation/*
    handle @gateway {
        request_body {
            max_size 6MB
        }
        reverse_proxy 127.0.0.1:8090
    }
    @chat path /chat /chat/*
    handle @chat {
        request_body {
            max_size 128KB
        }
        reverse_proxy 127.0.0.1:8088
    }
    handle {
        respond "Unauthorized" 401
    }
}
