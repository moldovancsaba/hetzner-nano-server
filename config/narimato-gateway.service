[Unit]
Description=Shared text and image job router
After=network.target docker.service
[Service]
DynamicUser=yes
StateDirectory=narimato-gateway
StateDirectoryMode=0700
Environment=MODEL_USAGE_PATH=/var/lib/narimato-gateway/model-usage.json
EnvironmentFile=/etc/narimato-gateway.env
EnvironmentFile=/etc/narimato-model-cleanup.env
Environment=TOKENIZERS_PARALLELISM=false
ExecStart=/opt/narimato-gateway-venv/bin/python /opt/narimato-gateway/gateway/server.py
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryMax=384M
CPUQuota=50%
TasksMax=40
UMask=0077
[Install]
WantedBy=multi-user.target
