[Unit]
Description=Shared text and image job router
After=network.target docker.service
[Service]
DynamicUser=yes
EnvironmentFile=/etc/narimato-gateway.env
ExecStart=/usr/bin/python3 /opt/narimato-gateway/gateway/server.py
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryMax=384M
CPUQuota=50%
TasksMax=40
UMask=0077
[Install]
WantedBy=multi-user.target
