[Unit]
Description=Pandora private chat
After=network.target docker.service
[Service]
DynamicUser=yes
EnvironmentFile=/etc/narimato-chat.env
Environment=TOKENIZERS_PARALLELISM=false
ExecStart=/opt/narimato-gateway-venv/bin/python /opt/narimato-chat/server.py
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryMax=192M
[Install]
WantedBy=multi-user.target
