{
  "version": "model-storage.v2",
  "hard_free_disk_floor_gib": 4,
  "target_free_disk_gib": 8,
  "target_weight_cache_gib": 16,
  "pin_all_ranked_defaults": true,
  "automatic_weight_deletion": true,
  "discovery_snapshot_days": 30,
  "discovery_snapshot_budget_mib": 50,
  "retention": {
    "production_input_disk": "never",
    "production_result_memory_seconds": 300,
    "training_capture_from_production": false,
    "benchmark_and_decline_metadata": "retain_versioned",
    "approved_training_artifacts": "separate_access_controlled_store_with_manifest",
    "training_requires_explicit_dataset_approval": true,
    "training_and_holdout_must_be_separate": true
  },
  "keep_top_per_task": 3,
  "keep_production_request_days": 3,
  "exclude_test_requests": true,
  "initial_inventory_history_grace_days": 0,
  "protect_resident_and_queued_models": true,
  "cleanup_cadence": "hourly_plus_up_to_five_minutes_jitter",
  "model_weights_only": true
}
